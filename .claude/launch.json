{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "keycloak-theme",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "keycloak-theme",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "docs",
        "run",
        "serve",
        "--",
        "--port",
        "3210",
        "--no-open"
      ],
      "port": 3210
    }
  ]
}
