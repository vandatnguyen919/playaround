# Copy to .env next to compose.prod.yml. On the VM: root-owned, mode 0600.
# Every value without a default here is required; compose refuses to start
# without it.

# Public hostnames (DNS A records to the VM).
AUTH_HOST=auth.example.com
APP_HOST=app.example.com

# Let's Encrypt. Keep the staging CA until a cert issues, then switch to
# https://acme-v02.api.letsencrypt.org/directory
ACME_EMAIL=you@example.com
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Images to run. CI (.github/workflows/ci.yml) publishes only
# sha-<git sha> tags, so set all three to the same commit for `pull`. Unset,
# they default to :latest, which only a local `up --build` creates.
KEYCLOAK_IMAGE=ghcr.io/vandatnguyen919/playground-keycloak:sha-<git sha>
GATEWAY_IMAGE=ghcr.io/vandatnguyen919/playground-gateway:sha-<git sha>
API_IMAGE=ghcr.io/vandatnguyen919/playground-api:sha-<git sha>

# Keycloak database (Postgres container, named volume keycloak-db).
KC_DB_PASSWORD=change-me

# Created on first boot only (empty database).
# Admin console user, used over the SSH tunnel.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Service account client that keycloak-config signs in with.
KC_CONFIG_CLIENT_ID=keycloak-config
KC_CONFIG_CLIENT_SECRET=change-me
# Loopback port for the admin console tunnel (default 8080).
#KC_ADMIN_PORT=8080

# Redis password for the gateway's ACL user (no spaces). Long and random:
#   openssl rand -base64 32
REDIS_PASSWORD=change-me

# Realm values, resolved into infra/playground-realm.json.
GATEWAY_CLIENT_SECRET=change-me
GOOGLE_CLIENT_ID=google-client-id-not-configured
GOOGLE_CLIENT_SECRET=google-client-secret-not-configured
GITHUB_CLIENT_ID=github-client-id-not-configured
GITHUB_CLIENT_SECRET=github-client-secret-not-configured

# Outgoing mail: OCI Email Delivery SMTP, STARTTLS on 587. See EMAIL.md.
# SMTP_FROM must be an approved sender on an email domain with DKIM active.
# User and password: an SMTP credential of an OCI user (not the console login).
SMTP_HOST=smtp.email.<region>.oci.oraclecloud.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USER=ocid1.user.oc1..<id>@ocid1.tenancy.oc1..<id>.<xx>.com
SMTP_PASSWORD=change-me
# Read only by mailcheck.mjs (dns), not by compose.
# DKIM selector chosen in OCI; SPF host for the region's continent
# (rp. Americas, ap.rp. Asia Pacific, eu.rp. Europe).
MAIL_DKIM_SELECTOR=playground-202610
MAIL_SPF_INCLUDE=ap.rp.oracleemaildelivery.com
