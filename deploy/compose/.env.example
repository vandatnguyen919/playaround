# Copy to .env next to compose.prod.yml. On the VM: root-owned, mode 0600.
# Every value without a default here is required; compose refuses to start
# without it.

# Public hostnames (DNS A records to the VM).
AUTH_HOST=auth.example.com
APP_HOST=app.example.com

# Let's Encrypt. Keep the staging CA until a cert issues, then switch to
# https://acme-v02.api.letsencrypt.org/directory
ACME_EMAIL=you@example.com
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Image to run (default ghcr.io/vandatnguyen919/playground-keycloak:latest).
#KEYCLOAK_IMAGE=ghcr.io/vandatnguyen919/playground-keycloak:<tag>

# Keycloak database (Postgres container, named volume keycloak-db).
KC_DB_PASSWORD=change-me

# Created on first boot only (empty database).
# Admin console user, used over the SSH tunnel.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Service account client that keycloak-config signs in with.
KC_CONFIG_CLIENT_ID=keycloak-config
KC_CONFIG_CLIENT_SECRET=change-me
# Loopback port for the admin console tunnel (default 8080).
#KC_ADMIN_PORT=8080

# Realm values, resolved into infra/playground-realm.json.
GATEWAY_CLIENT_SECRET=change-me
GOOGLE_CLIENT_ID=google-client-id-not-configured
GOOGLE_CLIENT_SECRET=google-client-secret-not-configured
GITHUB_CLIENT_ID=github-client-id-not-configured
GITHUB_CLIENT_SECRET=github-client-secret-not-configured

# Outgoing mail (OCI Email Delivery SMTP).
SMTP_HOST=smtp.email.<region>.oci.oraclecloud.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USER=
SMTP_PASSWORD=
