{
  "realm": "playground",
  "enabled": true,
  "displayName": "authn-authz-playground",
  "loginTheme": "keycloak-theme",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "smtpServer": {
    "host": "$(env:SMTP_HOST)",
    "port": "$(env:SMTP_PORT)",
    "from": "$(env:SMTP_FROM)",
    "fromDisplayName": "authn-authz-playground",
    "ssl": "$(env:SMTP_SSL)",
    "starttls": "$(env:SMTP_STARTTLS)",
    "auth": "$(env:SMTP_AUTH)",
    "user": "$(env:SMTP_USER)",
    "password": "$(env:SMTP_PASSWORD)"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"fullName\",\"displayName\":\"Full name\",\"validations\":{\"length\":{\"max\":120},\"pattern\":{\"pattern\":\"^[^<>&\\\"$%!#?§;*~/\\\\\\\\|^=\\\\[\\\\]{}\\\\u0000-\\\\u001F\\\\u007F]*$\",\"error-message\":\"Full name cannot contain < > & \\\" $ % ! # ? § ; * ~ / \\\\ | ^ = [ ] { }\"}},\"required\":{\"roles\":[\"admin\",\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "$(env:GOOGLE_CLIENT_ID)",
        "clientSecret": "$(env:GOOGLE_CLIENT_SECRET)",
        "defaultScope": "openid profile email"
      }
    },
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "$(env:GITHUB_CLIENT_ID)",
        "clientSecret": "$(env:GITHUB_CLIENT_SECRET)",
        "defaultScope": "read:user user:email"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "name to fullName",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": {
        "syncMode": "IMPORT",
        "jsonField": "name",
        "userAttribute": "fullName"
      }
    },
    {
      "name": "name to fullName",
      "identityProviderAlias": "github",
      "identityProviderMapper": "github-user-attribute-mapper",
      "config": {
        "syncMode": "IMPORT",
        "jsonField": "name",
        "userAttribute": "fullName"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular application user"
      },
      {
        "name": "admin",
        "description": "Application administrator"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-playground",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "user"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-playground",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "gateway",
      "name": "BFF Gateway",
      "description": "Server-side confidential OAuth2 client for the BFF gateway. The browser never sees its tokens.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "$(env:GATEWAY_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "$(env:APP_URL)/*"
      ],
      "webOrigins": [
        "$(env:APP_URL)"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "full name from the fullName attribute",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "fullName",
            "claim.name": "name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles for gateway authorization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "backchannel.logout.url": "$(env:GATEWAY_BACKCHANNEL_LOGOUT_URL)",
        "backchannel.logout.session.required": "true",
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "client.secret.creation.time": "2026-10-18T00:00:00Z"
      }
    }
  ],
  "authenticationFlows": [
