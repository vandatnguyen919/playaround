{
  "mount": "secret",
  "prefix": "playground",
  "services": {
    "gateway": { "namespace": "playground" },
    "keycloak": { "namespace": "playground" },
    "keycloak-config": { "namespace": "playground" },
    "redis": { "namespace": "playground" },
    "postgres": { "namespace": "playground" },
    "jenkins": { "namespace": "ci" }
  },
  "secrets": {
    "gateway-client": {
      "description": "Client secret of the gateway OIDC client in the realm",
      "readers": ["gateway", "keycloak-config"],
      "keys": {
        "client_secret": { "env": "GATEWAY_CLIENT_SECRET", "compose": true, "default": "gateway-dev-secret" }
      }
    },
    "jenkins-client": {
      "description": "Client secret of the private Jenkins OIDC client in the realm",
      "readers": ["jenkins", "keycloak-config"],
      "keys": {
        "client_secret": { "env": "JENKINS_CLIENT_SECRET", "compose": true, "default": "jenkins-dev-secret" }
      }
    },
    "redis": {
      "description": "Password of the gateway ACL user in Redis",
      "readers": ["redis", "gateway"],
      "keys": {
        "password": { "env": "REDIS_PASSWORD", "compose": true, "default": "redis-dev-password" }
      }
    },
    "keycloak-admin": {
      "description": "Keycloak bootstrap admin user, read on first boot only",
      "readers": ["keycloak"],
      "keys": {
        "username": { "env": "KC_BOOTSTRAP_ADMIN_USERNAME", "compose": true, "default": "admin" },
        "password": { "env": "KC_BOOTSTRAP_ADMIN_PASSWORD", "compose": true, "default": "admin" }
      }
    },
    "keycloak-config-client": {
      "description": "Service account client that keycloak-config signs in with (compose.prod.yml and later)",
      "readers": ["keycloak", "keycloak-config"],
      "keys": {
        "client_id": { "env": "KC_CONFIG_CLIENT_ID", "default": "keycloak-config" },
        "client_secret": { "env": "KC_CONFIG_CLIENT_SECRET" }
      }
    },
    "keycloak-db": {
      "description": "Password of the keycloak database user (compose.prod.yml and later; dev runs on H2)",
      "readers": ["keycloak", "postgres"],
      "keys": {
        "password": { "env": "KC_DB_PASSWORD" }
      }
    },
    "idp-google": {
      "description": "Google OAuth app, placeholders until feature 3",
      "readers": ["keycloak-config"],
      "keys": {
        "client_id": { "env": "GOOGLE_CLIENT_ID", "compose": true, "default": "google-client-id-not-configured" },
        "client_secret": { "env": "GOOGLE_CLIENT_SECRET", "compose": true, "default": "google-client-secret-not-configured" }
      }
    },
    "idp-github": {
      "description": "GitHub OAuth app, placeholders until feature 3",
      "readers": ["keycloak-config"],
      "keys": {
        "client_id": { "env": "GITHUB_CLIENT_ID", "compose": true, "default": "github-client-id-not-configured" },
        "client_secret": { "env": "GITHUB_CLIENT_SECRET", "compose": true, "default": "github-client-secret-not-configured" }
      }
    },
    "smtp": {
      "description": "Outgoing mail login. Placeholder locally: dev mail goes to Mailpit, and the Resend key stays on the VM",
      "readers": ["keycloak-config"],
      "keys": {
        "user": { "env": "SMTP_USER", "default": "not-configured" },
        "password": { "env": "SMTP_PASSWORD", "default": "not-configured" }
      }
    }
  }
}
