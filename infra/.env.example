# Copy to .env to override the defaults baked into docker-compose.yml.
# Everything here is local dev only. No real secrets.

# Keycloak admin console (master realm) at http://localhost:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Client secret of the "gateway" confidential client in the playground realm.
# Resolved from ${GATEWAY_CLIENT_SECRET} inside playground-realm.json.
GATEWAY_CLIENT_SECRET=gateway-dev-secret

# OAuth app credentials. Create the apps using the callback URLs in README.md.
# Leave these as placeholders until the providers are configured.
GOOGLE_CLIENT_ID=google-client-id-not-configured
GOOGLE_CLIENT_SECRET=google-client-secret-not-configured
GITHUB_CLIENT_ID=github-client-id-not-configured
GITHUB_CLIENT_SECRET=github-client-secret-not-configured

# Test users in the playground realm (passwords are dev-only):
#   alice / alice1234   role: user
#   admin / admin1234   roles: user, admin
